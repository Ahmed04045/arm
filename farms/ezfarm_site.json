{
  "id": "ezfarm_site",
  "name": "EZFarm · QU-ARS red amaranth",
  "crop": "purple amaranth",
  "system": "EZFarm IoT beds (Nano sensor nodes + ESP32 gateway)",
  "location": "Doha, Qatar",
  "tank_litres": 20,
  "network_file": "quars_amaranth_network.json",

  "mqtt": {
    "host": "localhost",
    "port": 1883,
    "username": "",
    "password": "",
    "client_id": "agent-network",
    "topic_prefix": "sensornet"
  },

  "interval_seconds": 60,
  "briefing_times": ["06:00", "18:00"],
  "window_minutes": 60,
  "stale_after_seconds": 120,
  "max_actions": 5,
  "publish_thresholds": ["temperature", "humidity", "soil_moisture", "water_level", "air_quality"],

  "nodes": {
    "1": {"name": "Bed 1"},
    "2": {"name": "Bed 2"}
  },

  "sensors": {
    "temperature":     {"capability": "air_temperature"},
    "humidity":        {"capability": "humidity"},
    "light_intensity": {"capability": "light"},
    "air_quality":     {"capability": "air_quality"},
    "soil_moisture":   {"capability": "soil_moisture",
                        "calibration": {"raw": [800, 350], "value": [0, 100],
                                        "note": "Raw ADC with the probe in dry air -> 0 %, in water -> 100 %. Measure your probe and edit."}},
    "water_level":     {"capability": "water_level",
                        "calibration": {"raw": [0, 600], "value": [0, 100],
                                        "note": "Raw ADC with the tank empty -> 0 %, full -> 100 %. Measure your tank and edit."}}
  }
}
